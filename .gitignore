# Node modules
node_modules/

# Build output — generated by scripts/build.js, published by GitHub Actions.
# data/library.json is NOT ignored: it is the committed data snapshot.
dist/

# Environment variables (never commit these!)
.env
.env.local

# Tag suggestions — a scratch file for review, regenerated on demand by
# scripts/suggest-tags.js. The tags themselves live in Airtable once applied.
data/tag-suggestions.json

# Mac
.DS_Store

# Logs
*.log

# IDE
.vscode/
.idea/
.claude/
